integrations:
- name: nri-haproxy
  env:
    # A user defined cluster name for the HAProxy instance
    HA_PROXY_CLUSTER_NAME: my_haproxy_1

    # Basic auth username
    USERNAME: cacheuser
    # Basic auth password
    PASSWORD: password
    
    # The URL to the enabled stats page on the
    # HAProxy instance
    STATS_URL: http://haproxy-instance/stats

    # Skip TLS certificate verification when STATS_URL uses HTTPS.
    # Only enable this if you trust the network path to the HAProxy instance.
    # INSECURE_SKIP_VERIFY: false

  interval: 15s
  labels:
    env: production
    label: haproxy-cluster-member-1
  inventory_source: config/haproxy
